4dafbb8a1745bc6ddb5d7919f3c8a795d87bb924fe7750413da49cf9b0dcac2b,margeo2015,sea_level_indicator,Figure caption,narrative_fallback_1,,,inferred_map,,-76.0,MSL,reported,marine_terrace,narrative fallback: submerged geomorphic sea-level feature,"[-78.5, -73.5]",1.3,stratigraphic_context,"marine terrace at Figure caption, reported around 76 m depth",Figure caption,␀--  - ,https://doi.org/10.1016/j.margeo.2015.10.016,0.55,Narrative fallback cluster from prose description of submerged palaeolandscape; depth uncertainty widened pending human review.,"{""page"": null, ""figure"": null, ""table"": null, ""section"": ""Figure caption"", ""quote_or_paraphrase"": ""mplified stratigraphic section of the upper 280 mbsl of the Hawaii Scientific Drilling Project drill core (based on Lipman and Moore, 1996 and Moore et al., 1996). Carbonate deposits between 27 and 52 mbsl correspond to terrace H1a, now buried by younger (about 1.3 ka) Panaewa lavas and not evident in the bathymetry data. Several coastal deposits occur intercalated between the volcanics in the lower half of the section. The transition between Mauna Loa and Mauna Kea volcanics is now located at 276 mbsl. Age of carbonate sediments from this study and Moore et al. (1996). Age of volcanics from Beeson et al. (1996; see Table 1).""}","{""reported_elevation_m"": null, ""reported_depth_m"": 76.0, ""reported_datum"": ""MSL"", ""reported_uncertainty_m"": null}","{""raw_raster_value_m"": null, ""applied_correction_m"": null, ""derived_elevation_m"": null, ""derived_depth_m"": null, ""derivation_notes"": ""Existing elevation preserved; no raster overwrite applied.""}","[{""method"": ""stratigraphic_context"", ""relation"": ""unknown"", ""age_ka"": 1.3, ""uncertainty_ka"": null, ""material"": null, ""notes"": ""Narrative fallback age context; review before analytical use.""}]",-76,-76,-76,-76
ff08b66ad0aabee737423c98f098786f1302696dac72da785bf9ca33bdf8ff0c,mccullough1992,sea_level_indicator,Methods,narrative_fallback_1,41.7342779,12.2823274,inferred_text,10000.0,-9.0,MSL,reported,marine_terrace,narrative fallback: submerged geomorphic sea-level feature,"[-11.5, -6.5]",null,other,"marine terrace at Methods, reported around 9 m depth","Key Methods, 32, Municipio Roma X, Lido di Ostia, Roma, Roma Capitale, Lazio, 00122, Italia","Dynamic hydrology and diagenesis of a submerged Pleistocene fringing reef, Discovery Bay, Jamaica",https://doi.org/10.1016/0025-3227(92)90089-Z,0.8,Narrative fallback cluster from prose description of submerged palaeolandscape; depth uncertainty widened pending human review. Geocoded from contextual query 'Methods'.,"{""page"": null, ""figure"": null, ""table"": null, ""section"": ""Methods"", ""quote_or_paraphrase"": ""With aid of scuba equipment, fourteen 7.62 cm diameter cores (Fig. 1) were drilled into the inner reef terrace in water depths between 4 and 14 m, and one core was drilled into a reef lobe on the outer terrace at a depth of 17 m. Wells B and C were drilled using a 2.54 cm core bit after the larger bit became wedged unrecoverably during drilling of core A. The hydraulic drill allowed for vertical penetration in lithified material up to 6.5 m, with usually better than 75% recovery when the larger bit was used. The inner terrace, which is mostly exposed as a hardground, permitted fairly shallow and easy drilling, as opposed to the sandy or coral covered outer terrace, and thus""}","{""reported_elevation_m"": null, ""reported_depth_m"": 9.0, ""reported_datum"": ""MSL"", ""reported_uncertainty_m"": null}","{""raw_raster_value_m"": null, ""applied_correction_m"": null, ""derived_elevation_m"": null, ""derived_depth_m"": null, ""derivation_notes"": ""Existing elevation preserved; no raster overwrite applied.""}","[{""method"": ""other"", ""relation"": ""unknown"", ""age_ka"": null, ""uncertainty_ka"": null, ""material"": null, ""notes"": ""Narrative fallback age context; review before analytical use.""}]",-9,-9,-9,-9
