b246d580b74ec1f29a790e8a88bc4177b68facb78758d801182cdcc0ef7d03dc,etienne2021,sea_level_indicator,Lansdowne Bank,mineru_llm_4_1,,,inferred_map,,-75,MSL,reported,marine_terrace,submerged reef level,null,null,other,"Continuous, flat morphology interpreted as a submerged reef level at ca. 70–80 mbsl on the uppermost slope of the Lansdowne Bank, in fore reef environments.",Lansdowne Bank,etienne2021,https://doi.org/10.1016/j.margeo.2021.106477,0.52,Possible correlation between the terrace and the S2 unconformity in seismic data. No contextual geocode result was found.,"{""page"": """", ""figure"": ""Fig. 5"", ""table"": null, ""section"": null, ""quote_or_paraphrase"": ""3D bathymetric views and sparker seismic profiles showing a continuous, flat morphology interpreted as a submerged reef level at ca. 70\u201380 mbsl on the uppermost slope of the Lansdowne Bank, in fore reef environments.""}","{""reported_elevation_m"": null, ""reported_depth_m"": null, ""reported_datum"": null, ""reported_uncertainty_m"": null}","{""raw_raster_value_m"": null, ""applied_correction_m"": null, ""derived_elevation_m"": null, ""derived_depth_m"": null, ""derivation_notes"": ""Existing elevation preserved; no raster overwrite applied.""}","[{""method"": ""other"", ""relation"": ""unknown"", ""age_ka"": null, ""uncertainty_ka"": null, ""material"": null, ""notes"": ""LLM-assisted extraction; raw BP-like numeric ages are normalized to ka.""}]",-75,-75,-75,-75
94b9048d72769f7d1a180ff82bd93c5c24a17be756ed32ace4a77db3233f664b,etienne2021,sea_level_indicator,A B S T R A C T,narrative_fallback_1,,,inferred_map,,-60.0,MSL,reported,marine_terrace,narrative fallback: submerged geomorphic sea-level feature,"[-62.5, -57.5]",null,other,"marine terrace at A B S T R A C T, reported around 60 m depth",A B S T R A C T,"Large-scale margin collapses along a partly drowned, isolated carbonate platform (Lansdowne Bank, SW Pacific Ocean)",https://doi.org/10.1016/j.margeo.2021.106477,0.55,Narrative fallback cluster from prose description of submerged palaeolandscape; depth uncertainty widened pending human review.,"{""page"": null, ""figure"": null, ""table"": null, ""section"": ""A B S T R A C T"", ""quote_or_paraphrase"": ""processes such as the upslope propagation of bypass morphologies by retrogressive headward erosion cannot be ruled out. In terms of geomorphic and stratigraphic constraints, the documented bank margin collapses affect a terrace located in 70 m water depth around the bank, which, depending on its age and origin, could provide a minimum age for collapse events. Finally, considering the shallow water depth of failure headscarps, the volumes of material involved in the slides as well as their vicinity to the nearby main island of New Caledonia, numerical simulations of the tsunamigenic potential of submarine slides have been performed. They showed that these slides would have been able to produce a meter-scale wave that would reach the northern coast of the island in less than an hour.""}","{""reported_elevation_m"": null, ""reported_depth_m"": 60.0, ""reported_datum"": ""MSL"", ""reported_uncertainty_m"": null}","{""raw_raster_value_m"": null, ""applied_correction_m"": null, ""derived_elevation_m"": null, ""derived_depth_m"": null, ""derivation_notes"": ""Existing elevation preserved; no raster overwrite applied.""}","[{""method"": ""other"", ""relation"": ""unknown"", ""age_ka"": null, ""uncertainty_ka"": null, ""material"": null, ""notes"": ""Narrative fallback age context; review before analytical use.""}]",-60,-60,-60,-60
