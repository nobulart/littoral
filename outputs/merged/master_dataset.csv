dc492e875d76410462388ee70c5602fe7dc5badd9aadb8a10373d22d42cce6b8,herzer1971,sea_level_indicator,"Bowie Seamount. A Recently Active, Flat-topped Seamount in the Northeast Pacific Ocean $^{1}$",narrative_fallback_1,,,inferred_map,,-157.5,MSL,reported,marine_terrace,narrative fallback: submerged geomorphic sea-level feature,"[-160.0, -155.0]","""Pleistocene""",stratigraphic_context,"marine terrace at Bowie Seamount. A Recently Active, Flat-topped Seamount in the Northeast Pacific Ocean $^{1}$, reported around 157.5 m depth","Bowie Seamount. A Recently Active, Flat-topped Seamount in the Northeast Pacific Ocean $^{1}$","Bowie Seamount. A Recently Active, Flat-topped Seamount in the Northeast Pacific Ocean $^{1}$",,0.55,Narrative fallback cluster from prose description of submerged palaeolandscape; depth uncertainty widened pending human review.,"{""page"": null, ""figure"": null, ""table"": null, ""section"": ""Bowie Seamount. A Recently Active, Flat-topped Seamount in the Northeast Pacific Ocean $^{1}$"", ""quote_or_paraphrase"": ""da at 53\u00b0 18' N, 135\u00b0 39' W, is a long northeast-trending, volcanic mountain comprising a series of intersecting ridges. These ridges may have grown from extrusions along intersecting fractures in the oceanic crust. Two terraces form the flattened summit of the volcano at approximate depths of 80 and 235 m. These are thought to be remnants of platforms produced by combined shallow-water vulcanism and wave erosion during Pleistocene and Recent times when sea level was lower than it is today. The last episode of volcanic activity on the summit occurred after the formation of the upper terrace which is probably no more than 18 000 years old. Samples dredged from the upper half of the volcano include: pillow fragments, fragments of non-pillowed flows, pillow breccias, bombs, tuffs, ash, and un""}","{""reported_elevation_m"": null, ""reported_depth_m"": 157.5, ""reported_datum"": ""MSL"", ""reported_uncertainty_m"": null}","{""raw_raster_value_m"": null, ""applied_correction_m"": null, ""derived_elevation_m"": null, ""derived_depth_m"": null, ""derivation_notes"": ""Existing elevation preserved; no raster overwrite applied.""}","[{""method"": ""stratigraphic_context"", ""relation"": ""unknown"", ""age_ka"": ""Pleistocene"", ""uncertainty_ka"": null, ""material"": null, ""notes"": ""Narrative fallback age context; review before analytical use.""}]",-157.5,-157.5,-157.5,-157.5
