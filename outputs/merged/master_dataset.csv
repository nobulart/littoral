0ab6a1fee24d7e3dcb674697e0eba30d8ca2ad6c6dc0a012b5980d2ab34d14c1,burchell1932,sea_level_indicator,"Curran, Larne",llm_feature_1,54.8508458,-5.8183116,inferred_text,10000.0,7.62,unknown,other,raised_beach,llm-extracted candidate,null,"""Early Neolithic""",Cultural association (gravel artifacts),"The Lower Estuarine Clay, containing a Late Magdalenian flint industry, underlies the gravels of the 25-foot raised-beach at the Curran. Marine sands with a molluscan fauna separate the clay and the raised-beach gravels.","Larne, Co. Antrim","Burchell, J. P. T. (1932). Implements of Late Magdalenian Age underlying the Raised-Beach at Larne, Co. Antrim. Nature, 129, 739.",,0.85,"The term '25-foot' refers to the elevation of the raised-beach. The stratigraphic sequence implies a regression or stable high stand (deposition of clay) followed by a transgression (marine sands and raised-beach). Geocoded from contextual query 'Larne, Co. Antrim, Ireland'.","{""page"": """", ""figure"": null, ""table"": null, ""section"": null, ""quote_or_paraphrase"": ""Lower Estuarine Clay ... underlies the gravels of the 25-foot raised-beach on the Curran at Larne contains a similar industry... sections on the Curran appear to offer geological support... period of erosion was followed by the formation of marine sands characterised by a molluscan fauna... overlying raised-beach gravels.""}","{""reported_elevation_m"": null, ""reported_depth_m"": null, ""reported_datum"": null, ""reported_uncertainty_m"": null}","{""raw_raster_value_m"": null, ""applied_correction_m"": null, ""derived_elevation_m"": null, ""derived_depth_m"": null, ""derivation_notes"": ""Existing elevation preserved; no raster overwrite applied.""}","[{""method"": ""Cultural association (gravel artifacts)"", ""relation"": ""unknown"", ""age_ka"": ""Early Neolithic"", ""uncertainty_ka"": null, ""material"": null, ""notes"": ""LLM-assisted extraction; raw BP-like numeric ages are normalized to ka.""}]",7.62,7.62,7.62,7.62
