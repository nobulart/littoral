7b1f68abda6bb33ab8fd9298855a6bf21b0eb9f581540fb46213d51af578fa9f,andrews1980,sea_level_indicator,Field Evidence,narrative_fallback_1,,,inferred_map,,-15.0,MSL,reported,submerged_beach,narrative fallback: submerged geomorphic sea-level feature,"[-17.5, -12.5]","""Holocene""",stratigraphic_context,"submerged beach at Field Evidence, reported around 15 m depth",Field Evidence,Progress in Relative Sea Level and Ice Sheet,,0.55,Narrative fallback cluster from prose description of submerged palaeolandscape; depth uncertainty widened pending human review.,"{""page"": null, ""figure"": null, ""table"": null, ""section"": ""Field Evidence"", ""quote_or_paraphrase"": ""Figure 6 is similar to an earlier diagram for the area of Narpaing Fjord (Fig. 5) (Phesant and Andrews, 1973). There are a series of 'high' shorelines with C $^{14}$ and uranium series dates of $\\gg$ 40,000 BP and amino acid ratios (free) $\\gg$ 0.31 (Table 1); there is then a series of dates between 8000 and 9000 BP that define an upper Holocene shoreline (Andrews and colleagues, 1972; Miller, 1973); there is evidence of recent submergence with dates of about 1000 years old on a series of soils and peats covered by beach gravels; and finally there are a series of distinct submerged glacio-marine deltas at depths of 10 to 20 m below sea level. Dyke (1977) provides a more detailed version of this diagram for the""}","{""reported_elevation_m"": null, ""reported_depth_m"": 15.0, ""reported_datum"": ""MSL"", ""reported_uncertainty_m"": null}","{""raw_raster_value_m"": null, ""applied_correction_m"": null, ""derived_elevation_m"": null, ""derived_depth_m"": null, ""derivation_notes"": ""Existing elevation preserved; no raster overwrite applied.""}","[{""method"": ""stratigraphic_context"", ""relation"": ""unknown"", ""age_ka"": ""Holocene"", ""uncertainty_ka"": null, ""material"": null, ""notes"": ""Narrative fallback age context; review before analytical use.""}]",-15,-15,-15,-15
