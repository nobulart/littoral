a8802ac0c2e8ae51e031f1fae56968986081bed013c0535717310e5bafe0ba13,rose1975,sea_level_indicator,"Glasgow, Glasgow City, Alba / Scotland, G2 1AL, United Kingdom",heuristic_feature_1,55.861155,-4.2501687,inferred_text,10000.0,24.0,MSL,SRTM15+V2,raised_beach,heuristically extracted from explicit text,null,0.3,radiocarbon,"Raised beach gravels and ice wedge casts at Old Kilpatrick, near Glasgow","Glasgow, Glasgow City, Alba / Scotland, G2 1AL, United Kingdom","Raised beach gravels and ice wedge casts at Old Kilpatrick, near Glasgow",,0.85,"Extracted using heuristic parser from pdf text after methods: mineru_hybrid_auto_markdown, mineru_content_list. Place name geocoded from query 'Glasgow'.","{""page"": ""1-2"", ""figure"": null, ""table"": null, ""section"": null, ""quote_or_paraphrase"": ""# Raised beach gravels and ice wedge casts at Old Kilpatrick, near Glasgow J. Rose Department of Geography, Birkbeck College, University of London # SYNOPSIS Landforms, sediments, and sedimentary structures at Old Kilpatrick reveal a beach ridge disturbed by involutions and ice wedge casts. The relationship of the beach ridge to other shorelines and radiocarbon dated marine shells shows that east of Old Kilpatrick the Clyde Basin was submerged""}","{""reported_elevation_m"": null, ""reported_depth_m"": null, ""reported_datum"": null, ""reported_uncertainty_m"": null}","{""raw_raster_value_m"": 24.0, ""applied_correction_m"": null, ""derived_elevation_m"": 24.0, ""derived_depth_m"": null, ""derivation_notes"": ""Elevation sampled from SRTM15+V2 at inferred coordinates because source elevation was not reported. Treat this as approximate spatial context, not a surveyed sample elevation.""}","[{""method"": ""radiocarbon"", ""relation"": ""equal"", ""age_ka"": 0.3, ""uncertainty_ka"": null, ""material"": null, ""notes"": ""Extracted from text span: 300 B.P.""}]",24,24,24,24
6ed6ce26963d7b05544c895b87ed6c316d68b52b46a5ed639c06af303c1da9a2,rossetti2014,sea_level_indicator,Narrative evidence locality,narrative_fallback_1,,,inferred_map,,-0.65,MSL,reported,marine_terrace,narrative fallback: submerged geomorphic sea-level feature,"[-3.15, 1.85]",3.0,stratigraphic_context,"marine terrace at Narrative evidence locality, reported around 0.65 m depth",Narrative evidence locality,Late Quaternary fluvial terrace evolution in the main southern Amazonian tributary,https://doi.org/10.1016/j.catena.2013.11.021,0.55,Narrative fallback cluster from prose description of submerged palaeolandscape; depth uncertainty widened pending human review.,"{""page"": null, ""figure"": null, ""table"": null, ""section"": null, ""quote_or_paraphrase"": ""T3, though not exclusive of, reinforce a tectonic in\ufb02uence during terrace evolution. Furthermore, these trends are re\ufb02ected in the modern Madeira River valley by long rectilinear NE\u2013SW trending segments alternating with broad meanders, also de\ufb01ned by either NE\u2013SW or NW\u2013SE straight lines. The information provided here leads us to call for a model of terrace evolution that, in addition to climate, also takes into account tectonic activity along the Madeira River valley. Most publications relating the genesis of \ufb02uvial terraces to tectonics are based on changes in uplift rate through time. In addition, tectonic subsidence affects the ratio b""}","{""reported_elevation_m"": null, ""reported_depth_m"": 0.65, ""reported_datum"": ""MSL"", ""reported_uncertainty_m"": null}","{""raw_raster_value_m"": null, ""applied_correction_m"": null, ""derived_elevation_m"": null, ""derived_depth_m"": null, ""derivation_notes"": ""Existing elevation preserved; no raster overwrite applied.""}","[{""method"": ""stratigraphic_context"", ""relation"": ""unknown"", ""age_ka"": 3.0, ""uncertainty_ka"": null, ""material"": null, ""notes"": ""Narrative fallback age context; review before analytical use.""}]",-0.65,-0.65,-0.65,-0.65
